<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable template used programmatically to build a Prosperity Path step card.
     Kept as XML for clarity even though ProsperityActivity inflates copies in code. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/textStepNumber"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_number"
            android:gravity="center"
            android:textColor="@color/marchers_gold_light"
            android:textStyle="bold"
            android:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textStepTitle"
                style="@style/HeadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="Step title" />

            <TextView
                android:id="@+id/textStepDesc"
                style="@style/BodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:text="Step description" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle"
            android:contentDescription="@null" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
